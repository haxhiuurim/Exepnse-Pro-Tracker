APP_ENV=production
APP_DEBUG=false

DB_DRIVER=sqlite
SQLITE_PATH=storage/database.sqlite

# MySQL (optional)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=inpenso
# DB_USERNAME=root
# DB_PASSWORD=

# Comma-separated origins, or * for any (fine for native mobile clients)
CORS_ORIGINS=*

# Super-admin bootstrap (php scripts/seed_admin.php)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now-please
ADMIN_NAME=Super Admin
